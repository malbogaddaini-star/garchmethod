//@version=6
strategy("RSI(14) Mean Reversion — BTC/USD 1D",
     overlay                    = true,
     initial_capital            = 100000,
     currency                   = currency.USD,
     commission_type            = strategy.commission.percent,
     commission_value           = 0.1,               // 0.1% per side (charged on each fill)
     pyramiding                 = 0,
     slippage                   = 0,
     process_orders_on_close    = false,             // signals at close → fills at next bar open
     fill_orders_on_standard_ohlc = true)

// Rules are defined on daily candles only — refuse anything else
if barstate.isfirst and timeframe.period != "D"
    runtime.error("This strategy is specified for the 1D timeframe only.")

// ── Fixed parameters (per spec — no inputs, no discretion) ───────────────────
int   RSI_LEN   = 14
float RSI_ENTRY = 30.0
float RSI_EXIT  = 50.0
int   SMA_LEN   = 200
int   ATR_LEN   = 14
float STOP_MULT = 1.5
int   MAX_BARS  = 10      // time stop: exit after the close of the 10th candle held
float RISK_PCT  = 0.01    // 1% of equity risked per trade

// ── Indicators (ta.rsi / ta.atr use Wilder smoothing, matching the spec) ─────
float rsi    = ta.rsi(close, RSI_LEN)
float sma200 = ta.sma(close, SMA_LEN)
float atr    = ta.atr(ATR_LEN)

// ── Entry: RSI crosses under 30, close above 200-SMA, currently flat ─────────
bool crossUnder = rsi < RSI_ENTRY and rsi[1] >= RSI_ENTRY
bool inUptrend  = close > sma200
bool longSignal = crossUnder and inUptrend and strategy.position_size == 0

// Stop distance is locked from the SIGNAL bar's ATR and never changes
var float stopDist = na

if longSignal
    stopDist := STOP_MULT * atr
    // Sizing at signal close (fill price is unknown until next open, so
    // the signal close is the deterministic proxy for the no-leverage cap)
    float riskQty = RISK_PCT * strategy.equity / stopDist
    float capQty  = strategy.equity / close
    strategy.entry("Long", strategy.long, qty = math.min(riskQty, capQty))

// ── Track the fill bar for the time stop ─────────────────────────────────────
var int entryBar = na
if strategy.position_size > 0 and strategy.position_size[1] == 0
    entryBar := bar_index

// ── Exits ────────────────────────────────────────────────────────────────────
if strategy.position_size > 0
    // 1) Hard stop: fill price − 1.5 × ATR(signal bar). Stop-market,
    //    intraday, never trails. Gaps through if it fills at the open (TV default).
    strategy.exit("Stop", from_entry = "Long",
         stop = strategy.position_avg_price - stopDist)

    // 2) Target: RSI reverts to the mean → market-on-next-open.
    // 3) Time stop: after MAX_BARS candles held → market-on-next-open.
    int barsHeld = bar_index - entryBar
    if rsi >= RSI_EXIT or barsHeld >= MAX_BARS
        strategy.close("Long", comment = rsi >= RSI_EXIT ? "target" : "time")
